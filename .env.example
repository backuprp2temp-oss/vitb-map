# VITmap Bhopal — environment variables
# Copy this file to `.env` and adjust values as needed.
# The app is fully functional without any backend or API keys:
# all campus data is bundled as static JSON, and favorites/menus are
# stored in the browser's localStorage.

# Overpass API endpoint used by the OSM import script (npm run import:osm).
# The public default requires no key. You may point it at a mirror or your
# own instance for higher rate limits.
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional contact address shown in the feedback dialog for reporting
# missing or incorrect campus locations (e.g. a campus club email).
VITE_FEEDBACK_EMAIL= campus-club@example.edu

# Optional: base URL of a future menu/backend adapter. Leave empty to use
# the bundled local menu data + localStorage-based admin editor.
VITE_MENU_API_URL=
